meta {
  name: Detalle de un vehículo (/vehicles/4)
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/api/v1/vehicles/4
  body: none
  auth: bearer
}

auth:bearer {
  token: {{userToken}}
}

tests {
  test("devuelve el Sand Crawler", function () {
    expect(res.status).to.equal(200);
    expect(res.body.id).to.equal("4");
    expect(res.body.name).to.equal("Sand Crawler");
    expect(res.body.filmIds).to.be.an("array");
  });
}

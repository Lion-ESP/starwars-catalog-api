meta {
  name: Métricas con ADMIN
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/actuator/metrics
  body: none
  auth: bearer
}

auth:bearer {
  token: {{adminToken}}
}

tests {
  test("responde 200 con la lista de métricas", function () {
    expect(res.status).to.equal(200);
    expect(res.body.names).to.be.an("array");
    expect(res.body.names).to.include("cache.gets");
  });
}

docs {
  Las métricas incluyen caché, Resilience4j y HTTP. Requieren rol ADMIN.
}

meta {
  name: Health (público)
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/actuator/health
  body: none
  auth: none
}

tests {
  test("responde 200 con status UP sin token", function () {
    expect(res.status).to.equal(200);
    expect(res.body.status).to.equal("UP");
  });
}

docs {
  La salud es pública: la usan el health check de Render y el smoke del CI.
}

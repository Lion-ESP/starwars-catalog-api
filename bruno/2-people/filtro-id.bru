meta {
  name: Filtro por id (id=1)
  type: http
  seq: 3
}

get {
  url: {{baseUrl}}/api/v1/people?id=1
  body: none
  auth: bearer
}

auth:bearer {
  token: {{userToken}}
}

tests {
  test("devuelve una página con una sola persona", function () {
    expect(res.status).to.equal(200);
    expect(res.body.content).to.have.lengthOf(1);
    expect(res.body.content[0].id).to.equal("1");
    expect(res.body.page).to.equal(1);
    expect(res.body.size).to.equal(10);
    expect(res.body.totalElements).to.equal(1);
    expect(res.body.totalPages).to.equal(1);
  });
}

docs {
  Filtrar por id devuelve igualmente una respuesta paginada, con el page y el size pedidos.
}

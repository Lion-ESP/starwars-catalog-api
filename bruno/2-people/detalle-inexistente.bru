meta {
  name: Detalle inexistente (404)
  type: http
  seq: 6
}

get {
  url: {{baseUrl}}/api/v1/people/9999
  body: none
  auth: bearer
}

auth:bearer {
  token: {{userToken}}
}

tests {
  test("responde 404 con Problem Details", function () {
    expect(res.status).to.equal(404);
    expect(res.body.status).to.equal(404);
    expect(res.body.title).to.be.a("string");
    expect(res.body.detail).to.be.a("string");
  });
}

docs {
  Los errores siguen el formato Problem Details (RFC 9457).
}

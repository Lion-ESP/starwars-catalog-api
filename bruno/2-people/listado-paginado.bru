meta {
  name: Listado paginado (page=2, size=10)
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/api/v1/people?page=2&size=10
  body: none
  auth: bearer
}

auth:bearer {
  token: {{userToken}}
}

tests {
  test("responde la página 2 con 10 personas y los totales de SWAPI", function () {
    expect(res.status).to.equal(200);
    expect(res.body.page).to.equal(2);
    expect(res.body.size).to.equal(10);
    expect(res.body.totalElements).to.equal(82);
    expect(res.body.totalPages).to.equal(9);
    expect(res.body.content).to.have.lengthOf(10);
  });
}

docs {
  La paginación se delega a SWAPI. La página es base 1 y los atributos numéricos se exponen como números.
}

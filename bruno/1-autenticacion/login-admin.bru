meta {
  name: Login de admin
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/v1/auth/login
  body: json
  auth: none
}

body:json {
  {
    "username": "{{admin}}",
    "password": "{{admin-password}}"
  }
}

script:post-response {
  if (res.status === 200) {
    bru.setVar("adminToken", res.body.accessToken);
  }
}

tests {
  test("responde 200 con un JWT Bearer", function () {
    expect(res.status).to.equal(200);
    expect(res.body.tokenType).to.equal("Bearer");
    expect(res.body.accessToken.split(".")).to.have.lengthOf(3);
  });
}

docs {
  Login del usuario demo con roles USER y ADMIN. Guarda adminToken, que se usa en la administración de caché y en las métricas.
}
